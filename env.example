# DxAi Environment Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# REQUIRED: OpenAI Configuration
# ===========================================

# OpenAI API Key (Required)
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI API Base URL (Optional)
# Use this if you have a proxy or custom OpenAI-compatible endpoint
# Default: https://api.openai.com/v1
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Database URL (Required for production)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/dxai

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Application Name (Optional)
# Default: DxAi
APP_NAME=DxAi

# Application URL (Optional)
# Used for generating absolute URLs
APP_URL=http://localhost:3000

# ===========================================
# SECURITY & AUTHENTICATION CONFIGURATION
# ===========================================

# Access Code (Optional - Simple Protection)
# Add a password to protect your DxAi instance
# If this value contains a comma, it is a password array
ACCESS_CODE=your-secure-access-code

# Enable Full Auth Protection (Optional)
# When enabled, all routes except public APIs require authentication
# ENABLE_AUTH_PROTECTION=1

# NextAuth Configuration (Recommended for SSO)
# Enable NextAuth for SSO login (Auth0, GitHub, Azure AD, etc.)
# NEXT_PUBLIC_ENABLE_NEXT_AUTH=1
# NEXT_AUTH_SECRET=your-secret-key-here
# Generate secret: openssl rand -base64 32

# Auto-click SSO button timeout (Optional)
# Time in milliseconds to automatically click SSO button when only 1 provider is available
# Set to 0 to disable auto-click
# Default: 3000 (3 seconds)
# NEXT_PUBLIC_AUTH_AUTO_CLICK_TIMEOUT=3000

# Auth0 SSO (Optional)
# AUTH0_CLIENT_ID=your-auth0-client-id
# AUTH0_CLIENT_SECRET=your-auth0-client-secret
# AUTH0_ISSUER=https://your-tenant.auth0.com

# GitHub OAuth (Optional)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Keycloak SSO (Optional)
# To use Keycloak, add 'keycloak' to NEXT_AUTH_SSO_PROVIDERS (e.g., NEXT_AUTH_SSO_PROVIDERS=casdoor,keycloak)
# AUTH_KEYCLOAK_ID=your-keycloak-client-id
# AUTH_KEYCLOAK_SECRET=your-keycloak-client-secret
# AUTH_KEYCLOAK_ISSUER=https://your-keycloak-server.com/realms/your-realm-name

# Clerk Authentication (Alternative to NextAuth)
# NEXT_PUBLIC_ENABLE_CLERK_AUTH=1
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
# CLERK_SECRET_KEY=sk_test_xxxxx

# ===========================================
# DEPLOYMENT NOTES
# ===========================================

# For Docker deployment:
# 1. Set OPENAI_API_KEY in your environment
# 2. Set DATABASE_URL if using external database
# 3. Run: docker-compose up -d

# For Vercel deployment:
# 1. Add OPENAI_API_KEY to Vercel environment variables
# 2. Add DATABASE_URL if using external database
# 3. Deploy normally

# ===========================================
# INTEGRATION CONFIGURATION
# ===========================================

# Integration Sync Secret (Optional)
# Secret token for securing the integration sync cron endpoint
# Used in: /api/cron/sync-integrations?secret=YOUR_SECRET_TOKEN
# INTEGRATION_SYNC_SECRET=your-secret-token-here

# ===========================================
# DEPLOYMENT NOTES
# ===========================================

# For local development:
# 1. Copy this file to .env.local
# 2. Fill in your OPENAI_API_KEY
# 3. Run: npm run dev
