# Database
DATABASE_URL=postgresql+asyncpg://scheduler_user:scheduler_pass@postgres:5432/scheduler_db

# LobeChat API Configuration
# Base URL of your LobeChat instance
LOBECHAT_API_BASE_URL=http://localhost:3210
# Prediction endpoint path (usually /api/v1/prediction)
LOBECHAT_PREDICTION_ENDPOINT=/api/v1/prediction

# Retry Configuration
# Number of retry attempts after initial failure (default: 2, total 3 attempts)
RETRY_MAX_ATTEMPTS=2
# Delay in seconds between retries (default: 300 = 5 minutes)
RETRY_DELAY_SECONDS=300

# Webhook Notification
# URL to send webhook notifications when schedule is disabled due to failures
# Leave empty to disable webhook notifications
WEBHOOK_NOTIFICATION_URL=https://your-webhook.example.com/notify

# MCP Server Configuration
# Host to bind the server (default: 0.0.0.0)
MCP_SERVER_HOST=0.0.0.0
# Port to bind the server (default: 8000)
MCP_SERVER_PORT=8000

# Authentication
# Secret token for authenticating cron calls from LobeChat
# Leave empty to disable authentication (not recommended for production)
CRON_SECRET_TOKEN=your-secret-token-here
